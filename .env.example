# =============================================================================
# VANTIQ: AI-Powered Business Intelligence Assistant — Environment Configuration
# =============================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# SQLite Database Persistence
# Defaults to instance/jarvis_business.db if not specified
JARVIS_DB_PATH=instance/jarvis_business.db

# Local AI Engine (Ollama Loopback)
# Strict security: Remote cloud AI APIs are blocked by design.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT=30.0
OLLAMA_TEMPERATURE=0.1
ENABLE_LOCAL_LLM=true

# Business Intelligence Configuration
MAX_UPLOAD_SIZE_MB=32
DEFAULT_CURRENCY=INR
LOW_STOCK_THRESHOLD_DEFAULT=5.0
